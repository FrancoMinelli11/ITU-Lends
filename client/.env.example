# =============================================================================
#  Variables de entorno - Frontend (Vite)
#  Copiar a `.env`:  cp .env.example .env
#  Vite solo expone variables con el prefijo VITE_ (se incorporan al bundle).
#  NUNCA poner secretos acá.
# =============================================================================

# URL base de la API REST (incluye /api al final)
VITE_API_URL=http://localhost:4000/api

# URL del servidor de Socket.io (sin /api)
VITE_SOCKET_URL=http://localhost:4000

# Nombre visible de la institución en la interfaz
VITE_NOMBRE_FACULTAD="Facultad de Ingeniería"
