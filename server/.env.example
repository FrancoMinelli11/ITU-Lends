# =============================================================================
#  Variables de entorno - Backend (Sistema de Préstamo de Computadoras)
#  Copiar este archivo a `.env` y completar los valores:  cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------------------
NODE_ENV=development
# Puerto donde escucha la API REST y el servidor de Socket.io
PORT=4000

# -----------------------------------------------------------------------------
# Base de Datos (PostgreSQL)
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BD?schema=public
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prestamos_itu?schema=public"

# -----------------------------------------------------------------------------
# Seguridad / JWT
# JWT_SECRET: generar con -> node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_EXPIRES_IN: duración del token (ej: 8h, 30m, 7d)
# -----------------------------------------------------------------------------
JWT_SECRET=reemplazar_por_un_secreto_largo_aleatorio_de_al_menos_32_caracteres
JWT_EXPIRES_IN=8h
# Costo del hash bcrypt (10-12 es el rango recomendado para producción)
SALT_ROUNDS=10

# -----------------------------------------------------------------------------
# CORS
# Orígenes permitidos separados por coma (URL del frontend con Vite)
# -----------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# Reglas de negocio (en minutos). Ajustables sin tocar código.
# -----------------------------------------------------------------------------
# Duración estándar de un préstamo
DURACION_PRESTAMO_MINUTOS=80
# Anticipación máxima con la que un alumno puede programar una reserva
ANTICIPACION_MAXIMA_MINUTOS=60
# Tiempo extra que espera la secretaría antes de dar por perdida una reserva
TOLERANCIA_CHECK_IN_MINUTOS=15
# Cuántos minutos antes del inicio programado se puede hacer check-in
ANTICIPACION_RETIRO_MINUTOS=10
# Cada cuánto corre el job que libera reservas vencidas (segundos)
INTERVALO_EXPIRACION_SEGUNDOS=30
# Sprint 3: minutos de aviso preventivo antes de que venza un préstamo activo
ALERTA_VENCIMIENTO_MINUTOS=15
# Sprint 3: minutos que suma cada extensión de préstamo (US-05)
EXTENSION_PRESTAMO_MINUTOS=60
# Sprint 3: ventana futura en la que una reserva posterior bloquea la extensión
VENTANA_EXTENSION_RESERVA_MINUTOS=60
# Sprint 3: frecuencia del job de alerta de vencimiento (segundos)
INTERVALO_ALERTA_SEGUNDOS=30
